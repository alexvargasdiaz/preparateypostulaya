{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/framework": "^12.0",
        "laravel/reverb": "^1.11",
        "laravel/socialite": "^5.28",
        "laravel/tinker": "^2.10.1",
        "maatwebsite/excel": "^3.1",
        "nwidart/laravel-modules": "^12.0",
        "twilio/sdk": "^8.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Auth\\": "Modules/Auth/app/",
            "Modules\\Auth\\Database\\Seeders\\": "Modules/Auth/database/seeders/",
            "Modules\\Catalogo\\": "Modules/Catalogo/app/",
            "Modules\\Catalogo\\Database\\Seeders\\": "Modules/Catalogo/database/seeders/",
            "Modules\\Examenes\\": "Modules/Examenes/app/",
            "Modules\\Examenes\\Database\\Seeders\\": "Modules/Examenes/database/seeders/",
            "Modules\\Preguntas\\": "Modules/Preguntas/app/",
            "Modules\\Preguntas\\Database\\Seeders\\": "Modules/Preguntas/database/seeders/",
            "Modules\\Rendicion\\": "Modules/Rendicion/app/",
            "Modules\\Rendicion\\Database\\Seeders\\": "Modules/Rendicion/database/seeders/",
            "Modules\\Resultados\\": "Modules/Resultados/app/",
            "Modules\\Resultados\\Database\\Seeders\\": "Modules/Resultados/database/seeders/",
            "Modules\\Notificaciones\\": "Modules/Notificaciones/app/",
            "Modules\\Notificaciones\\Database\\Seeders\\": "Modules/Notificaciones/database/seeders/",
            "Modules\\Dashboard\\": "Modules/Dashboard/app/",
            "Modules\\Dashboard\\Database\\Seeders\\": "Modules/Dashboard/database/seeders/",
            "Modules\\Progreso\\": "Modules/Progreso/app/",
            "Modules\\Progreso\\Database\\Seeders\\": "Modules/Progreso/database/seeders/",
            "Modules\\Historial\\": "Modules/Historial/app/",
            "Modules\\Historial\\Database\\Seeders\\": "Modules/Historial/database/seeders/",
            "Modules\\UserManagement\\": "Modules/UserManagement/app/",
            "Modules\\Bitacora\\": "Modules/Bitacora/app/",
            "Modules\\Bitacora\\Database\\Seeders\\": "Modules/Bitacora/database/seeders/",
            "Modules\\AIAgentes\\": "Modules/AIAgentes/app/",
            "Modules\\AIAgentes\\Database\\Seeders\\": "Modules/AIAgentes/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
